# =============================================================================
# LLM credentials — OpenAI API (chat completions)
# =============================================================================
OPENAI_API_KEY=                       # sk-...  (https://platform.openai.com/api-keys)
OPENAI_MODEL=gpt-4o-mini              # cost-efficient default
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# JIRA (only required for `testflow-issue` / `/testflow/generate-from-issue`)
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=

# Product context (Test Flow system prompt; needed for good results)
PRODUCT_CONTEXT=

# iTrust2 (used by `itrust2 testflow --page-url` to log in to a running app)
ITRUST2_USERNAME=
ITRUST2_PASSWORD=
ITRUST2_BASE=http://localhost:8080/iTrust2

# HTTP
HTTP_TIMEOUT=30
HTTP_USER_AGENT=atg-tools/0.1.0
