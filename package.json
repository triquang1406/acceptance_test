{
  "name": "itrust2-acceptance-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Chay bo Cypress spec sinh ra tu pipeline AutoUAT + Test Flow",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run --spec \"outputs/autouat/**/*.spec.ts\"",
    "cy:run:record": "cypress run --spec \"outputs/autouat/**/*.spec.ts\" --reporter json --reporter-options output=cypress-results.json",
    "cy:run:one": "cypress run --spec"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.70.0",
    "cypress": "^15.0.0",
    "typescript": "^5.6.0"
  }
}
